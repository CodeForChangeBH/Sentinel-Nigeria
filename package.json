{
  "name": "sentinel-nigeria",
  "version": "0.1.0",
  "private": true,
  "description": "Community-powered safety network protecting West African communities",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:web": "cd apps/web && npm run dev",
    "dev:realtime": "cd apps/realtime && npm run dev",
    "dev:ml": "cd packages/ml-service && python -m uvicorn main:app --reload",
    "build": "npm-run-all build:*",
    "build:web": "cd apps/web && npm run build",
    "build:realtime": "cd apps/realtime && npm run build",
    "test": "npm-run-all test:*",
    "test:web": "cd apps/web && npm test",
    "test:realtime": "cd apps/realtime && npm test",
    "lint": "npm-run-all lint:*",
    "lint:web": "cd apps/web && npm run lint",
    "lint:realtime": "cd apps/realtime && npm run lint",
    "mobile:ios": "cd apps/mobile && npm run ios",
    "mobile:android": "cd apps/mobile && npm run android",
    "db:migrate": "cd packages/database && npm run migrate",
    "db:seed": "cd packages/database && npm run seed"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
